
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database: "mariadb" (default) or "sqlite" for quick experiments
DB_ENGINE=mariadb
DB_NAME=news_app
DB_USER=news_user
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Approved-article integration (signal -> /api/approved/)
APPROVED_ARTICLE_ENDPOINT=http://127.0.0.1:8000/api/approved/
APPROVED_API_KEY=change-me-too

# Email: console backend prints emails in the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real email (e.g. Gmail with an app password):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=The Daily Ledger <newsroom@dailyledger.local>
